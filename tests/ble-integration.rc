# This file is loaded by an actual interactive Bash under a pseudo-terminal.

chroma_test_fail() {
  printf 'not ok - ble.sh integration: %s\n' "$1"
  exit 1
}

[[ -r ${CHROMA_BLESH_PATH:-} ]] || chroma_test_fail 'BLESH_PATH is unreadable'
[[ -r ${CHROMA_TEST_ROOT:-}/lib/layer.bash ]] || chroma_test_fail 'test root is invalid'

source "$CHROMA_BLESH_PATH" --attach=none || chroma_test_fail 'ble.sh failed to load'

# Stock Omarchy aliases `cd` to `zd`. Its fallback prints an icon and the new
# path, which used to leak into CHROMA_ROOT through command substitution.
zd() {
  builtin cd -- "${@: -1}" || return
  printf '\U000F17A9 %s\n' "$PWD"
}
alias cd=zd

polluted_root=$(cd -- "$CHROMA_TEST_ROOT")
[[ $polluted_root != "$CHROMA_TEST_ROOT" ]] ||
  chroma_test_fail 'Omarchy cd fixture did not reproduce path pollution'

loader_log=$(mktemp)
if ! source "$CHROMA_TEST_ROOT/chromarchy.bash" >"$loader_log" 2>&1; then
  loader_output=$(<"$loader_log")
  rm -f -- "$loader_log"
  chroma_test_fail "Chroma loader failed: ${loader_output//$'\n'/ | }"
fi
if [[ -s $loader_log ]]; then
  loader_output=$(<"$loader_log")
  rm -f -- "$loader_log"
  chroma_test_fail "Chroma loader printed startup noise: ${loader_output//$'\n'/ | }"
fi
rm -f -- "$loader_log"

[[ ${BLE_VERSION:-} ]] || chroma_test_fail 'BLE_VERSION is empty'
[[ ${CHROMA_ROOT:-} == "$CHROMA_TEST_ROOT" ]] ||
  chroma_test_fail "loader root was polluted: ${CHROMA_ROOT:-missing}"
[[ ${CHROMA_LAYER_READY:-0} == 1 ]] || chroma_test_fail 'semantic layer is not ready'
[[ ! ${bleopt_complete_auto_complete:-} ]] ||
  chroma_test_fail 'automatic suggestions are still enabled'
[[ ! ${bleopt_exec_errexit_mark:-} ]] ||
  chroma_test_fail 'red exit marker is still enabled'
ble/color/face2g syntax_error
[[ $ret == 0 ]] || chroma_test_fail "syntax errors still have a colored overlay: $ret"
ble/color/face2g argument_error
[[ $ret == 0 ]] || chroma_test_fail "argument errors still have a colored overlay: $ret"
[[ " ${_ble_highlight_layer_list[*]} " == *' omarchy_chroma '* ]] ||
  chroma_test_fail 'semantic layer was not registered'
[[ " ${_ble_hook_h_PRECMD[*]} " == *' chromarchy::theme_refresh '* ]] ||
  chroma_test_fail 'theme refresh hook was not registered'
[[ ${CHROMA_THEME_SOURCE:-} == omarchy ]] || chroma_test_fail 'Omarchy theme was not loaded'
[[ ${CHROMA_THEME_NAME:-} == "$CHROMA_EXPECTED_THEME" ]] ||
  chroma_test_fail "wrong theme name: ${CHROMA_THEME_NAME:-missing}"
[[ ${CHROMA_THEME_BACKGROUND:-} == "$CHROMA_EXPECTED_BACKGROUND" ]] ||
  chroma_test_fail "wrong theme background: ${CHROMA_THEME_BACKGROUND:-missing}"
[[ ${CHROMA_STYLES[install]:-} == "fg=$CHROMA_EXPECTED_INSTALL,bold" ]] ||
  chroma_test_fail "wrong install style: ${CHROMA_STYLES[install]:-missing}"

ble/highlight/layer/update 'sudo pacman -Syu firefox' || chroma_test_fail 'render update failed'
[[ ${_ble_highlight_layer_omarchy_chroma_osel[*]} == '0 4 5 11 12 16' ]] ||
  chroma_test_fail "wrong render spans: ${_ble_highlight_layer_omarchy_chroma_osel[*]}"
[[ ${#_ble_highlight_layer_omarchy_chroma_ogflags[@]} == 3 ]] ||
  chroma_test_fail 'wrong number of graphic styles'

ble/color/gspec2g "${CHROMA_STYLES[install]}"
expected_install_g=$ret
[[ ${_ble_highlight_layer_omarchy_chroma_ogflags[1]} == "$expected_install_g" &&
   ${_ble_highlight_layer_omarchy_chroma_ogflags[2]} == "$expected_install_g" ]] ||
  chroma_test_fail 'install style did not reach the render layer'

g=
ble/highlight/layer:omarchy_chroma/getg 5
[[ $g == "$expected_install_g" ]] || chroma_test_fail 'final layer lookup lost the install style'

ble/color/g#getfg "$g" || chroma_test_fail 'rendered style has no foreground'
rendered_color=$ret
((0x1000000 <= rendered_color && rendered_color < 0x2000000)) ||
  chroma_test_fail "rendered foreground is not truecolor: $rendered_color"
printf -v rendered_hex '#%06x' "$((rendered_color & 0xffffff))"
[[ $rendered_hex == "$CHROMA_EXPECTED_INSTALL" ]] ||
  chroma_test_fail "rendered foreground changed to $rendered_hex"
[[ $rendered_hex != "$CHROMA_EXPECTED_BACKGROUND" ]] ||
  chroma_test_fail 'rendered foreground equals the terminal background'

ble/color/g2sgr "$g"
rendered_sgr=$ret
[[ $rendered_sgr == *"38;2;$CHROMA_EXPECTED_INSTALL_RGB"* ]] ||
  chroma_test_fail 'terminal SGR is not the expected truecolor sequence'
rendered_buffer=$(printf '%s' "${_ble_highlight_layer_omarchy_chroma_buff[@]}")
[[ $rendered_buffer == *"$rendered_sgr"* ]] ||
  chroma_test_fail 'truecolor SGR is absent from the composed render buffer'

ble/color/g2sgr-ansi "$g"
canonical_sgr=$ret
expected_canonical=${CHROMA_EXPECTED_INSTALL_RGB//;/:}
[[ $canonical_sgr == *"38:2::$expected_canonical"* ]] ||
  chroma_test_fail 'canonical ANSI SGR is not the expected RGB color'

doctor_output=$(chromarchy::doctor) || chroma_test_fail 'chroma doctor reported a failure'
[[ $doctor_output == *"$CHROMA_EXPECTED_THEME"* &&
   $doctor_output == *"$CHROMA_EXPECTED_BACKGROUND"* &&
   $doctor_output == *'auto suggestions   disabled'* &&
   $doctor_output == *'red error feedback disabled'* ]] ||
  chroma_test_fail 'chroma doctor omitted theme or input-feedback diagnostics'

printf 'render-probe %sINSTALL\e[0m on %s\n' "$rendered_sgr" "$CHROMA_EXPECTED_THEME"

printf 'ok - real ble.sh ANSI render: %s\n' "$CHROMA_EXPECTED_THEME"
exit 0
