#!/usr/bin/env python3
"""Install the Command Chroma test widget from an extracted ZIP or checkout."""
import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "scripts"))
from installer_ui import Cancelled, Terminal, child_env  # noqa: E402

REPOSITORY = "https://github.com/itsVoid-TV/Omarchy-Chroma.git"
BRANCH = "codex/command-chroma-plugin"
PLUGIN_ID = "io.github.itsvoid-tv.command-chroma"
TOOLS = ("git", "mv", "omarchy-git-url-check", "omarchy-plugin-validate",
         "omarchy-plugin-catalog", "omarchy-plugin-list", "omarchy-plugin-enable",
         "omarchy-shell")


def paint(code, text):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR") is not None:
        return text
    return f"\033[{code}m{text}\033[0m"


def banner():
    Terminal(no_animation=True).banner("PLUGIN BOOTSTRAP")


def step(number, text):
    print(paint("1;38;2;169;112;255", f"[{number}/4]") + " " + text)


def run(argv, *, capture=False, timeout=30):
    env = child_env()
    env["GIT_TERMINAL_PROMPT"] = "0"
    return subprocess.run(argv, stdin=subprocess.DEVNULL, text=True,
                          capture_output=capture, check=True, timeout=timeout, env=env)


def check_destination(directory):
    target = directory / PLUGIN_ID
    if target.exists() or target.is_symlink():
        raise RuntimeError(f"Command Chroma already has a checkout at {target}.\n"
                           f"Update it with: omarchy plugin update {PLUGIN_ID}")
    catalog = json.loads(run(["omarchy-plugin-catalog"], capture=True).stdout)
    if not isinstance(catalog, list):
        raise RuntimeError("Could not read Omarchy's plugin catalog.")
    for entry in catalog:
        if entry.get("id") == PLUGIN_ID:
            raise RuntimeError(f"Plugin ID {PLUGIN_ID} is already in use. "
                               "Review the installed plugin before adding another copy.")


def install(directory, assume_yes=False):
    banner()
    step(1, "Checking Omarchy and the destination…")
    missing = [name for name in TOOLS if shutil.which(name) is None]
    if missing:
        raise RuntimeError("This setup needs Omarchy Quattro with its plugin commands.\n"
                           "Missing: " + ", ".join(missing))
    run(["omarchy-git-url-check", REPOSITORY])
    check_destination(directory)
    print(f"\nDevelopment source: {REPOSITORY}\nBranch: {BRANCH}")
    print("This downloads, validates and enables the widget in your Omarchy bar.")
    print("Omarchy plugins run as your user inside the desktop shell.")
    print("Bash setup follows in this terminal, with a separate review and confirmation.")
    print("--yes confirms only the widget; it never silently approves Bash changes.")
    if not assume_yes:
        if not sys.stdin.isatty():
            raise RuntimeError("Run ./setup in a terminal to confirm, or pass --yes explicitly.")
        if input("Install and enable this widget? [y/N] ").strip().lower() not in ("y", "yes"):
            print("Cancelled.")
            return

    directory.mkdir(parents=True, exist_ok=True)
    target = directory / PLUGIN_ID
    with tempfile.TemporaryDirectory(prefix=".command-chroma-", dir=directory) as temporary:
        stage = Path(temporary) / "repository"
        step(2, "Downloading the development branch…")
        run(["git", "clone", "--single-branch", "--branch", BRANCH, "--",
             REPOSITORY, str(stage)], timeout=180)
        step(3, "Validating the manifest and plugin files…")
        run(["omarchy-plugin-validate", str(stage)])
        manifest = json.loads((stage / "manifest.json").read_text(encoding="utf-8"))
        if manifest.get("id") != PLUGIN_ID:
            raise RuntimeError("The downloaded plugin has an unexpected ID. Nothing was enabled.")
        check_destination(directory)
        # GNU mv refuses to replace a destination that appeared during cloning.
        # -T also prevents nesting the checkout inside an existing directory.
        try:
            run(["mv", "-T", "--no-clobber", "--", str(stage), str(target)])
        except subprocess.CalledProcessError as error:
            if target.exists() or target.is_symlink():
                raise RuntimeError("The destination appeared during setup. The existing files were kept.") from error
            raise
        if stage.exists():
            raise RuntimeError("The destination appeared during setup. The existing files were kept.")

    try:
        step(4, "Registering and enabling the Chroma widget…")
        run(["omarchy-shell", "shell", "rescanPlugins"])
        deadline = time.monotonic() + 3
        while True:
            plugins = json.loads(run(["omarchy-plugin-list", "--json"], capture=True).stdout)
            if not isinstance(plugins, list):
                raise RuntimeError("Could not read Omarchy's discovered plugins.")
            if any(entry.get("id") == PLUGIN_ID for entry in plugins):
                break
            if time.monotonic() >= deadline:
                raise RuntimeError("Omarchy has not discovered the plugin yet.")
            time.sleep(0.05)
        run(["omarchy-plugin-enable", PLUGIN_ID])
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"The Git checkout was kept at {target}, but activation failed: {error}\n"
                           "Retry these commands in your Omarchy session:\n"
                           "  omarchy-shell shell rescanPlugins\n"
                           f"  omarchy plugin enable {PLUGIN_ID}") from error
    print("\n" + paint("1;38;2;82;214;255", "✓ Widget enabled."))
    print("Run ./setup --bash, or open the Chroma panel and choose Set up in terminal.")
    print("Then open a new Bash terminal and run: chroma doctor")
    print("You can remove the extracted download folder; the installed checkout is independent.")
    return target


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--yes", action="store_true", help="confirm the widget bootstrap, or Bash changes when used with --bash")
    parser.add_argument("--bash", action="store_true", help="set up the bundled Bash integration in this terminal")
    parser.add_argument("--preview", action="store_true", help="preview the terminal installer without changing anything")
    parser.add_argument("--no-animation", action="store_true", help="skip the ttfx / TTE intro")
    args = parser.parse_args()
    try:
        installer_args = ["--no-animation"] if args.no_animation else []
        if args.bash or args.preview:
            if args.yes:
                installer_args.append("--yes")
            if args.preview:
                installer_args.append("--preview")
            os.execv(sys.executable, [sys.executable, str(ROOT / "scripts/chroma-installer"), *installer_args])
        ui = Terminal(no_animation=args.no_animation or args.yes)
        ui.animate()
        # Omarchy itself uses this path, independently of XDG_CONFIG_HOME.
        target = install(Path.home() / ".config/omarchy/plugins", assume_yes=args.yes)
        if target and ui.interactive and not args.yes:
            # Same terminal; the installed checkout owns its independent assets.
            # The second stage ALWAYS reviews and asks for Bash consent.
            os.execv(sys.executable, [sys.executable, str(target / "scripts/chroma-installer"), "--no-animation"])
        return 0
    except Cancelled:
        print("Cancelled. No installation was started.")
        return 0
    except (OSError, RuntimeError, ValueError, EOFError, subprocess.SubprocessError) as error:
        print(f"Command Chroma setup: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nSetup interrupted. Any installed checkout is kept; inspect it before retrying.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    def interrupted(_signum, _frame):
        raise KeyboardInterrupt()
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    sys.exit(main())
