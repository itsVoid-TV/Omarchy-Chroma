#!/usr/bin/env bash
# Omarchy Chroma AI Stylist entry point.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  printf '%s\n' \
    'Usage: chroma ai "your styling request"' \
    '' \
    'Starts the local AI Stylist. With no request, you are prompted interactively.' \
    'Requires a local AI runtime (opencode, ollama, codex, claude, antigravity).'
  exit 0
fi
exec python3 "$(dirname -- "$0")/chroma-ai-agent.py" "$@"